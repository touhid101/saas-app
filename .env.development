# ═══════════════════════════════════════════════════════════════════════════
#  LOCAL DEVELOPMENT
# ═══════════════════════════════════════════════════════════════════════════
#
# Used automatically by:  npm run dev
#
# You do not switch anything by hand. Vite picks this file for `dev` and
# .env.production for `build`, so the two can never be confused — which is the
# whole reason they are separate files rather than one with lines commented out.
#
# Here the Vite dev server (5173) and Spring Boot (8585) are two different
# origins, so the API must be named in full. That makes the calls cross-origin,
# which is why application.yml allows http://localhost:5173 by default.
# ═══════════════════════════════════════════════════════════════════════════

VITE_API_BASE_URL=http://localhost:8585
