# ═══════════════════════════════════════════════════════════════════════════
#  Friends Pharma — backend environment
# ═══════════════════════════════════════════════════════════════════════════
#
# Copy to `.env` in the folder you START the application from, then edit:
#
#     cp .env.example .env
#
# Nothing here is required — every setting falls back to the default shown, and
# the application starts fine with no .env at all.
#
# `.env` is git-ignored; this example file is not. Keep real values out of it.
#
# ── Which folder? ──
#
# The file is looked for in BOTH the current directory and ./backend, so it
# works whether you launch from the project root or from backend/. The startup
# log names the files it actually read:
#
#     started in    D:\Saas\backend
#     read          D:\Saas\backend\.env
#
# ── Windows paths: forward slashes ──
#
# Read as a Java properties file, where "\" starts an escape sequence:
#
#     UPLOAD_ROOT=C:/pharma/uploads      correct
#     UPLOAD_ROOT=C:\pharma\uploads      wrong — \p is an escape
# ═══════════════════════════════════════════════════════════════════════════


# ═══════════════════════════════════════════════════════════════════════════
#  1. WHO MAY CALL THE API FROM A BROWSER
# ═══════════════════════════════════════════════════════════════════════════
#
# Exact match only. Scheme, host and port ALL count, a trailing slash breaks
# it, and there is no wildcard — credentials are enabled, and the CORS spec
# forbids "*" alongside them.
#
# ── LOCAL DEVELOPMENT ──
# The default already covers the Vite dev server, so leave this unset:
#     http://localhost:5173, http://localhost:5174, http://localhost:3000
#
# ── PRODUCTION ──
# Behind a reverse proxy the browser calls the SAME origin that served the
# page, so CORS should never come into it. Set this anyway: it costs nothing
# and it is the one fix that still works when the proxy headers are wrong.
# Include the port whenever the site is not on 443.
#
#CORS_ALLOWED_ORIGINS=https://www.amigoscloud.com:8444


# ═══════════════════════════════════════════════════════════════════════════
#  2. RUNNING BEHIND NGINX / IIS / A LOAD BALANCER
# ═══════════════════════════════════════════════════════════════════════════
#
# Defaults to FRAMEWORK, which trusts X-Forwarded-Proto / Host / Port. Without
# it the application believes it is http://127.0.0.1:8585 — the address nginx
# connects to — while the browser sends Origin: https://your-site:8444. It
# compares the two, calls a same-origin request cross-origin, and answers
# "403 Invalid CORS request".
#
# ── LOCAL DEVELOPMENT ──
# Nothing in front of the application, so nothing to trust. Optional, but
# honest, and it stops forwarded headers from a client being believed:
#FORWARD_HEADERS_STRATEGY=NONE
#
# ── PRODUCTION ──
# FRAMEWORK is the default; this line is only a reminder that it matters.
#FORWARD_HEADERS_STRATEGY=FRAMEWORK
#
# nginx must send the port, or Spring compares :443 against :8444 and refuses:
#     proxy_set_header X-Forwarded-Host $http_host;   # $host DROPS the port
#     proxy_set_header X-Forwarded-Port $server_port;


# ═══════════════════════════════════════════════════════════════════════════
#  3. WHERE UPLOADED FILES LIVE
# ═══════════════════════════════════════════════════════════════════════════
#
# ABSOLUTE paths are used as written. RELATIVE ones are anchored to the user's
# home directory — so the default lands on <user-home>/uploads and never inside
# the deployment folder, which a redeploy would wipe.
#
# One setting moves every upload folder. This is the one most people want.
#
# ── LOCAL DEVELOPMENT ──
#UPLOAD_ROOT=uploads
#
# ── PRODUCTION ──
# Somewhere backed up, and NOT inside the folder you redeploy over:
#UPLOAD_ROOT=D:/Saas/uploads

# Override one folder only when it must live apart from the others — a bigger
# disk for product photos, say. Each wins over UPLOAD_ROOT.
#UPLOAD_AVATAR_DIR=D:/Saas/uploads/avatars
#UPLOAD_LOGO_DIR=D:/Saas/uploads/logo
#UPLOAD_PRODUCT_IMAGE_DIR=E:/pharma-media/product_image
#UPLOAD_EMPLOYEE_IMAGE_DIR=D:/Saas/uploads/employee_image
#UPLOAD_EXPENSE_RECEIPT_DIR=D:/Saas/uploads/expense_receipt

# Largest file accepted, in bytes. 2 MB default.
#UPLOAD_MAX_SIZE_BYTES=2097152

# The public URLs those folders are served at.
#
# Change these ONLY if something in front rewrites the paths. Every image URL
# is built from them, so a value that disagrees with what the server serves
# breaks every picture at once. They must also stay under /uploads/, which is
# the prefix allowed through unauthenticated — the application warns at startup
# if you move one outside it.
#UPLOAD_AVATAR_URL_PREFIX=/uploads/avatars/
#UPLOAD_LOGO_URL_PREFIX=/uploads/logo/
#UPLOAD_PRODUCT_IMAGE_URL_PREFIX=/uploads/product_image/
#UPLOAD_EMPLOYEE_IMAGE_URL_PREFIX=/uploads/employee_image/
#UPLOAD_EXPENSE_RECEIPT_URL_PREFIX=/uploads/expense_receipt/
#
# In PRODUCTION nginx must proxy that path to the backend, or every image
# returns index.html and the pages look fine while the pictures are broken:
#
#     location /uploads/ {
#         proxy_pass       http://127.0.0.1:8585;
#         proxy_set_header Host $http_host;
#         expires 30d;
#     }


# ═══════════════════════════════════════════════════════════════════════════
#  MOVING EXISTING UPLOADS
# ═══════════════════════════════════════════════════════════════════════════
#
# Changing a path does not move what is already there. The database stores the
# public URL (/uploads/logo/branch_1_ab.png), not the folder, so copying the
# files across is enough — the existing rows keep working:
#
#     Windows    robocopy "C:\Users\You\uploads" "D:\Saas\uploads" /E
#     Linux      cp -r ~/uploads/. /var/lib/friendspharma/uploads/
#
# Copy rather than move until the application has restarted and images load.


# ═══════════════════════════════════════════════════════════════════════════
#  E-COMMERCE (docs/ecommerce)
# ═══════════════════════════════════════════════════════════════════════════
#
# Off unless ECOM_ENABLED=true: every /api/ecom/** request answers 404 and the
# ERP runs exactly as before. Switch it on per environment, never by editing
# application.yml.
#
# ECOM_JWT_SECRET signs CUSTOMER tokens and must differ from the staff secret.
# At least 32 characters. Rotating it signs every customer out.
#
# ── LOCAL DEVELOPMENT ──
#     ECOM_ENABLED=true
#     ECOM_JWT_SECRET=local-only-customer-secret-of-at-least-32-chars
#
# ── PRODUCTION ──
#     ECOM_ENABLED=false                 until the storefront launches
#     ECOM_JWT_SECRET=<random 64 chars>
#     ECOM_MAX_FAILED_LOGINS=5           wrong passwords before a lockout
#     ECOM_LOCKOUT_MINUTES=15
